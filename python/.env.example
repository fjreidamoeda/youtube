# Copie para .env e ajuste. Obrigatorio: YT_API_KEY
YT_API_KEY=

# URL publica do app (a que o painel IPTV vai acessar).
# Deixe VAZIO para o app detectar sozinho pelo endereco usado no acesso
# (recomendado). So preencha se o app estiver atras de um proxy/dominio.
BASE_URL=

# Caminhos dos executaveis (deixe vazio para usar o PATH do sistema)
FFMPEG=
FFPROBE=
YTDLP=

# cookies.txt do navegador (opcional, mas resolve video bloqueado/bot check)
YTDLP_COOKIES=

# Onde ficam cache/ e app.db
CACHE_DIR=cache
DB_PATH=app.db

# Ajustes de comportamento
MAX_CONCURRENT_DOWNLOADS=3
LOOP_MAX_AGE=21600
IPTV_WAIT_SECONDS=12
VLC_WAIT_SECONDS=20
CHANNEL_WAIT_SECONDS=25
WATCH_INTERVAL=240

# ---- HLS: como o video e entregue ao painel ------------------------------
# hls = playlist .m3u8 com segmentos (da para pular trecho, e o padrao)
# ts  = MPEG-TS continuo, igual o PHP antigo (use so se o painel recusar .m3u8)
# Troca rapida sem editar nada: na URL da playlist use &formato=ts
PLAYLIST_FORMAT=hls
HLS_TIME=4                 # duracao de cada segmento (2 a 10)
HLS_LIST_SIZE=30           # janela do modo canal (30 x 4s = 2 min de buffer)
HLS_PRESET=veryfast        # ultrafast usa menos CPU e da menos qualidade
HLS_FIRST_WAIT=25          # espera o 1o segmento antes de responder
HLS_IDLE_SECONDS=150       # encerra o ffmpeg apos este tempo sem nenhum leitor
HLS_MAX_SESSIONS=4         # transmissoes HLS simultaneas (cada uma usa 1 nucleo)
HLS_MAX_CACHE_MB=6000      # teto dos segmentos guardados em disco
HLS_VOD_MAX_AGE=86400      # refaz o VOD segmentado depois de 24h
